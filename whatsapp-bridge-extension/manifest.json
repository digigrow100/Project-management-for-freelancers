{
  "manifest_version": 3,
  "name": "Freelance HQ WhatsApp Bridge",
  "version": "1.2.5",
  "description": "Admin WhatsApp bridge with manual mapping, date history sharing, and controlled team access.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content-whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
