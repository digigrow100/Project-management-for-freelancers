# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). Never commit the real .env.local file — it's already
# gitignored.

# Project URL, e.g. https://abcdefghij.supabase.co
SUPABASE_URL=

# Settings > API > Project API keys > service_role (secret, server-only — do NOT
# prefix this with NEXT_PUBLIC_, and never expose it to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Settings > API > Project API keys > anon / public. Used only for the login flow
# (sign in/out) from Server Actions and edge middleware — never to query project/task
# data, and every table has Row Level Security enabled with no policies, so the anon
# key has zero data access even if used directly. Kept server-only (no NEXT_PUBLIC_
# prefix) since this app never needs it in browser-side code.
SUPABASE_ANON_KEY=

# Any long random string (e.g. `openssl rand -hex 32`). Server-only secret used to
# encrypt/decrypt saved backlink login passwords at rest. Required before you can
# save or reveal a password on the Backlinks tab — everything else in the app
# works fine without it. Losing or changing this value makes any previously saved
# backlink passwords permanently undecryptable.
BACKLINKS_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`), different from
# BACKLINKS_SECRET. Server-only secret used to encrypt/decrypt your saved Dynadot
# API key at rest (Domains → Dynadot Settings). Required before you can save that
# key — everything else on the Domains tab works fine without it. Losing or
# changing this value makes the saved key permanently undecryptable (just paste
# it in again).
DYNADOT_SECRET=

# From platform.openai.com/api-keys. Server-only secret used by the AI Assistant
# (Phase 6) to call the OpenAI Responses API. Required before the assistant can
# answer anything — everything else in the app works fine without it, and the
# assistant just responds with a "not configured yet" message until it's set.
OPENAI_API_KEY=
